# Copiază acest fișier în `.env` și completează valorile reale.
PORT=4000
NODE_ENV=development

# MongoDB Atlas — folosește un utilizator cu drepturi minime necesare.
MONGODB_URI=mongodb+srv://UTILIZATOR:PAROLA@cluster0.xxxxx.mongodb.net/sudoku1000?retryWrites=true&w=majority

# Secret pentru semnarea JWT — pune minim 32 de caractere aleatorii.
JWT_SECRET=schimba-ma-cu-un-secret-foarte-lung-si-aleatoriu
JWT_EXPIRES=7d

# Origin-uri permise pentru CORS, separate prin virgulă.
CORS_ORIGIN=http://localhost:5173,https://utilzatorul-tau.github.io
